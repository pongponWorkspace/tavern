NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Local Docker by default. With Neon, `neon checkout dev` writes these three (pooled, direct, branch name).
DATABASE_URL=postgres://tavern:tavern@localhost:54329/tavern
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
TEST_DATABASE_URL=postgres://tavern:tavern@localhost:54329/tavern_test
# 32+ random bytes, used to sign storage URLs and OAuth state cookies
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
STORAGE_DIR=.storage
# File storage: local (dev) or s3 (Cloudflare R2 / any S3-compatible bucket)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=tavern-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Ceiling for all stored files (default 9 GB keeps R2 inside its 10 GB free tier)
# STORAGE_TOTAL_LIMIT_BYTES=9663676416
# Optional — leave blank to hide "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
